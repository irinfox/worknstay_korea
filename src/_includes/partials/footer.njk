{% set regionNav = regions | regionFooterNav(page.url) %}
<footer class="site-footer">
  <div class="site-footer__inner">
    {% if regionNav.prev or regionNav.next %}
    <nav class="site-footer__regions" aria-label="Nearby regions">
      {% if regionNav.prev %}<a class="site-footer__link site-footer__prev" href="/regions/{{ regionNav.prev.slug }}/">&larr; {{ regionNav.prev.nameEn }}</a>{% endif %}
      {% if regionNav.next %}<a class="site-footer__link site-footer__next" href="/regions/{{ regionNav.next.slug }}/">{{ regionNav.next.nameEn }} &rarr;</a>{% endif %}
    </nav>
    {% endif %}
    <div class="site-footer__row">
      <p class="site-footer__disclaimer">{{ site.footer.disclaimer }}</p>
      <nav class="site-footer__links" aria-label="Project links">
        <a class="site-footer__link site-footer__link--out" href="{{ site.footer.repoUrl }}" target="_blank" rel="noopener">GitHub ↗</a>
        <a class="site-footer__link site-footer__link--out" href="{{ site.footer.feedbackUrl }}" target="_blank" rel="noopener">Feedback ↗</a>
      </nav>
    </div>
  </div>
</footer>
