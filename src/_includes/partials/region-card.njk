{# Single template for both region-info render modes (ARCHITECTURE.md, DESIGN.md § "Region
   card"): the wide-viewport infographic loops this into fixed slots around the map, the
   narrow-viewport carousel loops it into a scroll-snap row.
   Params: region (Region, required), rentSummary (rentalMarketScan.regionSummary entry | null), modifier ("infographic" | "carousel") #}
<div class="region-card region-card--{{ modifier | default("carousel") }}" data-region-slug="{{ region.slug }}">
  <div class="region-card__header">
    <h3 class="region-card__name">{{ region.nameEn }}</h3>
    {# Rent figure only where a real hand-checked range exists (rentalMarketScan.js
       regionSummary) — omitted rather than filled with a city-centre estimate if missing. #}
    {% if rentSummary and rentSummary.furnishedShortTermMonthly %}
    <span class="region-card__rent">{{ rentSummary.furnishedShortTermMonthly }}/mo</span>
    {% endif %}
  </div>
  <p class="region-card__name-ko">{{ region.nameKo }}</p>
  <p class="region-card__intro">{{ region.shortIntro }}</p>
  <ul class="region-card__tags">
    {% for tag in region.vibeTags %}
    <li data-vibe-tag="home_card">{{ tag }}</li>
    {% endfor %}
  </ul>
  {# The real <a href> both entry points to a region page share (CLAUDE.md); korea-map.js
     gates it (href + aria-disabled) for ineligible regions the same way it gates the map shape. #}
  <a class="region-card__link" href="/regions/{{ region.slug }}/">
    <span>Open {{ region.nameEn }}</span>
    <span aria-hidden="true">→</span>
  </a>
</div>
