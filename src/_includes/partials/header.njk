<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__logo" href="/">
      <span class="site-header__name">{{ site.name }}</span>
    </a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" aria-label="Primary">
      <ul id="primary-nav" class="site-nav__list">
        {% for item in site.nav %}
        <li class="site-nav__item">
          <a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
