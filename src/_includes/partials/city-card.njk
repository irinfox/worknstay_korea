{# Gangwon-do "Cities in this region" card (design reference 5b/5d). White bordered card:
   name + Korean name + vibe tags, blurb, a grey "Where to work" panel — solo venues (Website /
   Instagram / Naver Map text links) first, then any multi-location chains grouped under their
   own hairline-topped subtitle (DESIGN.md § "Chains" — plain name, a small same-row Website ↗
   link, no address/domain row since one link can't honestly point at a single site), then the
   study-café battery — then a "Getting around" line. No accordion — always open. Param: city
   (City, required). #}
<article class="city-card">
  <div class="city-card__head">
    <h3 class="city-card__name">{{ city.nameEn }} <span class="city-card__ko">{{ city.nameKo }}</span></h3>
    {% if city.vibeTags.length %}
    <ul class="city-card__tags">
      {% for tag in city.vibeTags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>

  {% if city.blurb %}<p class="city-card__blurb">{{ city.blurb }}</p>{% endif %}

  {% set soloVenues = city.workationCenters | activeVenues(false) %}
  {% set chainVenues = city.workationCenters | activeVenues(true) %}

  {% if city.workationCenters.length or city.otherWorkspaces.length %}
  <div class="city-work">
    <p class="city-work__title"><span class="city-work__tick" aria-hidden="true"></span>Where to work</p>

    {% for wc in soloVenues %}
    <div class="work-venue">
      <p class="work-venue__name">{{ wc.name }} <span class="work-venue__kind">{{ wc.kind or "coworking" }}</span></p>
      {% if wc.address %}
      <p class="work-venue__addr"><svg class="work-venue__pin" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 1a5 5 0 0 1 5 5c0 3.5-5 9-5 9S3 9.5 3 6a5 5 0 0 1 5-5Zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"/></svg>{{ wc.address }}</p>
      {% endif %}
      <p class="work-venue__links">
        {% if wc.url %}<a href="{{ wc.url }}" target="_blank" rel="noopener">Website{% if wc.korOnly %} (KR){% endif %} ↗</a>{% endif %}
        {% if wc.instagram %}<a href="https://instagram.com/{{ wc.instagram }}" target="_blank" rel="noopener">Instagram{% if wc.korOnly %} (KR){% endif %} ↗</a>{% endif %}
        {% if wc.mapUrl %}<a href="{{ wc.mapUrl }}" target="_blank" rel="noopener">Naver Map ↗</a>{% endif %}
      </p>
    </div>
    {% endfor %}

    {% if chainVenues.length %}
    <p class="work-venue-chains__title">Chains</p>
    <div class="work-venue-chains">
      {% for wc in chainVenues %}
      <span class="work-venue__chain-name">{{ wc.name }}</span>
      <a class="work-venue__chain-site" href="{{ wc.url }}" target="_blank" rel="noopener">Website{% if wc.korOnly %} (KR){% endif %} ↗</a>
      <span class="work-venue__kind">{{ wc.kind or "coworking" }}</span>
      {% endfor %}
    </div>
    {% endif %}

    {% for space in city.otherWorkspaces %}
    <div class="study-cafes">
      <span class="study-cafes__label">Study cafés</span>
      <span class="study-cafes__battery" aria-hidden="true">
        {% for n in range(1, 5) %}<span class="study-cafes__cell{% if n <= space.level %} study-cafes__cell--on{% endif %}"></span>{% endfor %}
      </span>
      <span class="study-cafes__count">
        {%- if space.level == 0 -%}none{%- elif space.level == 1 -%}a few{%- elif space.level == 2 -%}good{%- elif space.level == 3 -%}lots{%- else -%}plenty{%- endif -%}
      </span>
      <span class="sr-only">({{ space.level }} of 4)</span>
      <a class="study-cafes__search" href="https://map.naver.com/p/search/{{ city.nameKo }}%20스터디카페" target="_blank" rel="noopener">Naver Map<span class="study-cafes__search-word"> search</span> ↗</a>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if city.gettingAround.length %}
  <p class="city-card__around">
    <span class="city-card__around-label">Getting around:</span>
    {% for g in city.gettingAround -%}
      {#- `alt` holds any second way to the same place (e.g. Chuncheon: train + subway); each
         time stays bold, each mode grey -#}
      <span class="city-card__leg">{{ g.label }} <strong>{{ g.value }}</strong> <span class="city-card__mode">{{ g.mode or "bus" }}</span>
        {%- for a in g.alt %} <span class="city-card__mode" aria-hidden="true">·</span> <strong>{{ a.value }}</strong> <span class="city-card__mode">{{ a.mode }}</span>{% endfor -%}
      </span>
    {%- endfor %}
  </p>
  {% endif %}
</article>
