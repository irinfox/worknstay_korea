{#
  Real anchor-based tab nav (rule 6: functional without JS — links just jump to the section).
  tabs.js progressively enhances this into real single-panel switching when JS runs; without JS,
  every .region-section stays visible in normal document flow, links just jump.
  Param: tabs = [{ id, label }, ...]
#}
<nav class="tabs__nav" aria-label="Region page sections">
  <ul>
    {% for tab in tabs %}
    <li><a href="#{{ tab.id }}">{{ tab.label }}</a></li>
    {% endfor %}
  </ul>
</nav>
