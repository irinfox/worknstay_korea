<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}{% if title %} · {{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-48.png" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#16201C">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/components/header.css">
  <link rel="stylesheet" href="/assets/css/components/footer.css">
  <link rel="stylesheet" href="/assets/css/components/hero.css">
  <link rel="stylesheet" href="/assets/css/components/calculator.css">
  <link rel="stylesheet" href="/assets/css/components/korea-map.css">
  <link rel="stylesheet" href="/assets/css/components/region-card.css">
  <link rel="stylesheet" href="/assets/css/components/region-page.css">
  <link rel="stylesheet" href="/assets/css/components/region-detail-map.css">
  <link rel="stylesheet" href="/assets/css/components/city-card.css">
  <link rel="stylesheet" href="/assets/css/components/event-timeline.css">
  <link rel="stylesheet" href="/assets/css/components/static-pages.css">
  <link rel="stylesheet" href="/assets/css/components/not-found.css">
  <script type="module" src="/assets/js/main.js"></script>
</head>
<body{% if page.url == "/" %} class="has-hero"{% endif %}>
  {# Synchronous and inline (not the deferred main.js module) so it runs before first paint —
     header.css keys the collapsed-behind-burger nav on this class. Without it, that CSS only
     takes effect once main.js finishes parsing/executing (after the whole document), so every
     load — hard refreshes especially — flashes the full inline nav list open before it collapses.
     Runs if and only if JS is enabled, same as main.js, so the JS-disabled fallback (rule 6:
     nav always visible, real anchors) is untouched when it's off. #}
  <script>document.body.classList.add("js-nav-ready")</script>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "partials/header.njk" %}
  {{ content | safe }}
  {% include "partials/footer.njk" %}
</body>
</html>
