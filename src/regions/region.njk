---
pagination:
  data: regions
  size: 1
  alias: region
permalink: "/regions/{{ region.slug }}/"
layout: layouts/page.njk
eleventyComputed:
  title: "{{ region.nameEn }}"
  description: "{{ region.shortIntro }}"
---
{% set regionCities = cities | byRegion(region.slug) %}
{% set regionFood = food | byRegion(region.slug) %}
{% set heroPhotos = regionHeroPhotos[region.slug] or [] %}
{% set slideCount = heroPhotos.length %}
{% set isGangwon = region.slug == "gangwon-do" %}
{% set isJeju = region.slug == "jeju-do" %}
{% set isGyeonggi = region.slug == "gyeonggi-do" %}
{% set isChungcheong = region.slug == "chungcheong-do" %}
{% set isGyeongsang = region.slug == "gyeongsang-do" %}
{% set isJeolla = region.slug == "jeolla-do" %}
{% set hasDetailMap = isGangwon or isJeju or isGyeonggi or isChungcheong or isGyeongsang or isJeolla %}
{# Hand-chosen city set/order per region (mirrors Gangwon-do's existing pattern below) —
   bySlugs lets cities.json keep other records (e.g. Paju/Ganghwa, Andong/Tongyeong, Boryeong)
   for later reuse without surfacing them here. #}
{% set cityOrder = {
  "gyeonggi-do": ["seoul", "incheon", "suwon", "seongnam"],
  "gyeongsang-do": ["busan", "daegu", "ulsan", "gyeongju"],
  "jeolla-do": ["jeonju", "gwangju", "yeosu", "suncheon"],
  "jeju-do": ["jeju-city", "seogwipo"],
  "chungcheong-do": ["daejeon", "sejong", "cheongju", "gongju"]
} %}
{# Furnished short-term monthly rent for the headline recap card and the cost table below.
   Gangwon-do is the only region with a market scan behind it (src/_data/rentalMarketScan.js). #}
{% set gangwonRent = (rentalMarketScan.regionSummary | findBySlug("gangwon-do")).furnishedShortTermMonthly %}
<div class="content-page region-page" id="top">

<nav class="region-breadcrumb" aria-label="Breadcrumb">
  <a href="/#map">Regions</a> <span aria-hidden="true">/</span> <span class="region-breadcrumb__here">{{ region.nameEn }}</span>
</nav>

<header class="region-header region-header--split">
  <div class="region-header__main">
    <span class="region-header__rule" aria-hidden="true"></span>
    <h1>{{ region.nameEn }} <span class="region-header__ko">{{ region.nameKo }}</span></h1>
    {% if region.vibeTags.length %}
    <ul class="region-header__tags region-header__tags--vibe">
      {% for tag in region.vibeTags %}
      <li>{{ tag }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if region.longIntro | isArray %}
    {% for para in region.longIntro %}
    <p class="region-header__intro">{{ para | safe }}</p>
    {% endfor %}
    {% else %}
    <p class="region-header__intro">{{ region.longIntro | safe }}</p>
    {% endif %}
    {# Season line (design reference 5b): orange dot → bold season name → its window. The name is
       mapped from the seasonTags emoji key (the data carries emoji + window, no name field). #}
    {% set seasonNames = { "🏄": "Surf season", "⛷️": "Ski season", "🏂": "Snowboard season", "🏔️": "Hiking", "🥾": "Hiking", "🌸": "Flowers" } %}
    {% if region.seasonTags.length %}
    <ul class="region-seasons">
      {% for tag in region.seasonTags %}
      <li>
        <span class="region-seasons__dot" aria-hidden="true"></span>
        <span><strong>{{ seasonNames[tag.emoji] or "In season" }}</strong> {{ tag.label }}</span>
      </li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>

  <aside class="region-header__aside">
    {% if isGangwon %}
    <div class="rent-summary">
      <div class="rent-summary__row">
        <span class="rent-summary__label">Furnished short-term,<br>per month</span>
        <span class="rent-summary__figure">{{ gangwonRent }}</span>
      </div>
      <div class="rent-summary__note">
        <div>Based on hand-checked, decent furnished listings available to foreigners.</div>
        <div style="margin-top:4px">Last updated: September 2026.</div>
      </div>
    </div>
    {% endif %}
    {% if region.isCapitalArea %}
    <div class="note-plate note-plate--stricter">
      <span class="note-plate__text">Capital-area region — the higher income threshold applies, except in its <a href="/regions/gyeonggi-do/population-decline-areas/">population-decline areas</a>.</span>
      <a class="note-plate__link" href="/visa-info/">Visa info &rarr;</a>
    </div>
    {% else %}
    <div class="note-plate note-plate--easier">
      <span class="note-plate__text">Outside the capital area — the lower income threshold applies.</span>
      <a class="note-plate__link" href="/visa-info/">Visa info &rarr;</a>
    </div>
    {% endif %}
  </aside>
</header>

{# Sticky page-contents strip (DESIGN.md § "Page contents strip") — same shared component as
   visa-info/settling-in, reused as-is. Labels stay short generic nouns, not "Regional dishes" /
   "Region map" — the section's own H2 already carries the full wording. Map only exists where
   hasDetailMap is true (every region now has a hand-authored detail map), Dishes only where
   regionFood has entries — both
   real <a href>, so a page without one just doesn't render that link rather than pointing at a
   missing section. Rent and Events sit in the same tinted band and start at the same height on
   desktop, so page-contents.js detects the tie by position and highlights both together while
   the band is in view — no markup needed here for that, and on phone (where the band stacks)
   the same geometry check naturally activates just one at a time. #}
<div class="page-contents">
  <div class="page-contents__links">
    {% if hasDetailMap %}
    <a href="#region-map"><span class="page-contents__full">Map</span><span class="page-contents__short">Map</span></a>
    {% endif %}
    <a href="#cities"><span class="page-contents__full">Cities</span><span class="page-contents__short">Cities</span></a>
    <a href="#rent"><span class="page-contents__full">Rent</span><span class="page-contents__short">Rent</span></a>
    <a href="#events"><span class="page-contents__full">Events</span><span class="page-contents__short">Events</span></a>
    <a href="#places"><span class="page-contents__full">Places</span><span class="page-contents__short">Places</span></a>
    {% if regionFood.length %}
    <a href="#dishes"><span class="page-contents__full">Dishes</span><span class="page-contents__short">Dishes</span></a>
    {% endif %}
  </div>
  <a href="#top" class="page-contents__top" aria-label="Back to top"><span class="page-contents__top-icon" aria-hidden="true"></span><span class="page-contents__top-label">Top</span></a>
</div>

{# "Around the region" cover gallery: heroPhotos (regionHeroPhotos.json) is the ordered list of
   finalized, credited, license-checked picks per slug. The track is a plain CSS scroll-snap
   strip, swipeable/scrollable with zero JS (same no-JS pattern as .attraction-list) — the
   counter + prev/next arrows + autoplay (region-hero-gallery.js) are pure enhancement layered
   on top, so nothing here gates content behind JS. #}
{% if slideCount > 0 %}
<section class="region-gallery" aria-labelledby="region-gallery-heading"{% if slideCount > 1 %} data-region-hero-gallery{% endif %}>
  <div class="region-gallery__head">
    <div class="region-gallery__intro">
      <div class="region-section__head">
        <span class="region-section__tick" aria-hidden="true"></span>
        <h2 id="region-gallery-heading">Region highlights</h2>
      </div>
      <p class="region-gallery__sub">Selected spots to get a feel for the region</p>
    </div>
    {% if slideCount > 1 %}
    <div class="region-gallery__controls">
      <button class="region-hero-gallery__nav region-hero-gallery__nav--prev" type="button" aria-label="Previous photo">‹</button>
      <span class="region-gallery__counter" data-region-hero-counter aria-hidden="true">1 / {{ slideCount }}</span>
      <button class="region-hero-gallery__nav region-hero-gallery__nav--next" type="button" aria-label="Next photo">›</button>
    </div>
    {% endif %}
  </div>
  <div class="region-hero">
    <div class="region-hero-gallery__track">
      {% for filename in heroPhotos %}
      {% set credit = regionHeroCredits.photos[filename] %}
      <figure class="region-hero-gallery__slide">
        <img class="region-hero__img" src="/assets/img/hero/{{ region.slug }}/{{ filename }}" alt="{{ credit.titleEn }}" loading="{{ 'eager' if loop.first else 'lazy' }}">
        {% if credit.titleEn %}
        <figcaption class="region-hero__caption">
          <span class="region-hero__caption-title">{{ credit.titleEn }}</span>
          {% if credit.cityEn or credit.titleKo %}
          <span class="region-hero__caption-sub">{{ credit.cityEn }}{% if credit.cityEn and credit.titleKo %} · {% endif %}{{ credit.titleKo }}</span>
          {% endif %}
        </figcaption>
        {% endif %}
      </figure>
      {% endfor %}
    </div>
  </div>
  <p class="region-hero__credit">Photo source: © Korea Tourism Organization (한국관광공사)</p>
</section>
{% endif %}

{% if hasDetailMap %}
{# Hand-authored detail maps — one per region (src/assets/svg/{slug}-detail-map.svg). Pin
   coordinates are looked up via the KTO OpenAPI (searchKeyword2) where a place is in its
   catalog. Gangwon/Jeju each use their own lat/lng-to-local-xy linear fit (calibrated on their
   own city pins — see those two files' own comments). The other four regions share one linear
   fit instead, since they all crop from the same korea-regions.svg coordinate frame (see
   gyeonggi-detail-map.svg's comment for the fit itself). None of this is a real map projection,
   so treat spacing as illustrative, not survey-accurate. #}
<section class="region-section region-section--map" id="region-map">
  <div class="region-section__head">
    <span class="region-section__tick" aria-hidden="true"></span>
    <h2>Region map</h2>
  </div>
  <p class="region-section__sub">Approximate positions, drawn from KTO coordinates</p>
  <div class="region-detail-map">
    <div class="region-detail-map__scroll">
      {% if isGangwon %}
      {% inlineSvg "gangwon-detail-map.svg" %}
      {% elif isJeju %}
      {% inlineSvg "jeju-detail-map.svg" %}
      {% elif isGyeonggi %}
      {% inlineSvg "gyeonggi-detail-map.svg" %}
      {% elif isChungcheong %}
      {% inlineSvg "chungcheong-detail-map.svg" %}
      {% elif isGyeongsang %}
      {% inlineSvg "gyeongsang-detail-map.svg" %}
      {% elif isJeolla %}
      {% inlineSvg "jeolla-detail-map.svg" %}
      {% endif %}
    </div>
    <p class="region-detail-map__legend">
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 13.5V6.2l4-2.7 4 2.7v7.3M10.5 13.5V8h3v5.5M1.5 13.5h13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>City</span>
      {% if isGangwon or isJeju or isJeolla %}
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 12.5 6 4.5l2.6 4.6M6.6 12.5 10.5 5.5l4 7H1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>Mountain</span>
      {% endif %}
      {% if isGangwon %}
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.2 12.6c1.4-1.5 2.8-1.5 4.2 0 1.4 1.5 2.8 1.5 4.2 0 1.4-1.5 2.8-1.5 4.2 0" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.4 1.6c.6 3.4-1.2 6.4-4.9 8 .6-3.9 2.4-6.6 4.9-8Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>Surf beach</span>
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.6 3.4 9 10.4c.9.9 2.1 1.3 3.4 1.1M4.2 1.8l7.4 7c.9.9 2.1 1.3 3.4 1.1" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>Ski resort</span>
      {% elif isJeju %}
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.2 12.6c1.4-1.5 2.8-1.5 4.2 0 1.4 1.5 2.8 1.5 4.2 0 1.4-1.5 2.8-1.5 4.2 0" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.4 1.6c.6 3.4-1.2 6.4-4.9 8 .6-3.9 2.4-6.6 4.9-8Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>Surf beach</span>
      {% elif isGyeongsang %}
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0.9 5.7l1.2 1.2q1.1 0 2.4-3.9c2.3.9 4.7.9 7 0q1.3 3.9 2.4 3.9l1.2-1.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 13.5V9.8M11.5 13.5V9.8M2.5 13.5h11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>History</span>
      {% elif isJeolla %}
      <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5V7" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 9.5C5 9.8 2.6 8.2 1.8 5c3-.2 5.4 1.4 6.2 4.5Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 7c3 .3 5.4-1.3 6.2-4.5-3-.2-5.4 1.4-6.2 4.5Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>Greenery</span>
      {% endif %}
    </p>
  </div>
</section>
{% endif %}

{% if region.usefulLinks.length %}
<section class="region-section region-section--guides">
  <div class="region-guides">
    <span class="region-guides__head">
      <span class="region-guides__tick" aria-hidden="true"></span>
      <span class="region-guides__label">Guides:</span>
    </span>
    <span class="region-guides__items">
      {% for link in region.usefulLinks %}
      <span class="region-guides__item">
        <a class="region-guides__link" href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }} ↗</a>
        <span class="region-guides__meta">{{ link.sourceLabel }}{% if link.sourceDate %} · {{ link.sourceDate }}{% endif %}</span>
      </span>
      {% endfor %}
    </span>
  </div>
</section>
{% endif %}

<section class="region-section region-section--cities" id="cities">
  <div class="region-section__head">
    <span class="region-section__tick" aria-hidden="true"></span>
    <h2>Cities</h2>
  </div>
  <p class="region-section__sub">Where to stay and work in the region</p>
  {% if isGangwon %}
  {# The 4 cities with real coworking / study-café options (Yangyang is a surf-village day trip,
     not somewhere to base a month-long stay, so it's map-only — see its surf-beach pin above). #}
  {% set cityList = cities | bySlugs(["sokcho", "gangneung", "chuncheon", "wonju"]) %}
  {% include "partials/city-card-list.njk" %}
  {% elif cityOrder[region.slug] %}
  {% set cityList = cities | bySlugs(cityOrder[region.slug]) %}
  {% include "partials/city-card-list.njk" %}
  {% elif regionCities.length %}
  {% set cityList = regionCities %}
  {% include "partials/city-card-list.njk" %}
  {% else %}
  {% set message = "No cities listed for this region yet." %}
  {% include "partials/empty-state.njk" %}
  {% endif %}
  {% if cityList.length %}
  <p class="data-provenance">Population data for {{ populationSource.period }}. Source: <a href="{{ populationSource.url }}" target="_blank" rel="noopener" title="{{ populationSource.linkTitle }}">KOSIS({{ populationSource.source }}, {{ populationSource.surveyName }}) ↗</a>, {{ populationSource.retrievedAt }}. {{ populationSource.roundingNote }}</p>
  {% endif %}
</section>

{# Costs + festivals: one primary-tinted band that does the section-divider job (DESIGN.md
   § region page order). Costs left, festivals right on desktop; stacked on phone. #}
<div class="region-band">
  <div class="region-band__inner">
    <div class="region-band__col region-band__col--costs" id="rent">
      <div class="region-section__head">
        <span class="region-section__tick" aria-hidden="true"></span>
        <h2>Rental prices</h2>
      </div>
      {% if isGangwon %}
      {# Rows and note are a restructuring of the existing verified Gangwon cost copy into the
         design's table form; figures unchanged. #}
      <dl class="cost-table">
        <div><dt>Short-term stay, per month</dt><dd>{{ gangwonRent }}</dd></div>
        <div><dt>Typical size</dt><dd>23–30 m² and up</dd></div>
        <div><dt>Same money in Seoul</dt><dd>13–16 m²</dd></div>
        <div><dt>Upfront deposit</dt><dd>none or ₩330K</dd></div>
      </dl>
      <p class="cost-note">The prices shown are for decent furnished stays available to foreigners, without a large upfront deposit or long-term contract. Stays in this region generally offer more space for the money than in Seoul. Sokcho has the widest range of flexible options, while Wonju is the cheapest overall.</p>
      <p class="cost-link"><a href="/settling-in/">A short intro into Korean renting →</a></p>
      {% else %}
      <p class="empty-state">No cost-of-living figures for this region yet.</p>
      {% endif %}
    </div>

    <div class="region-band__col region-band__col--events" id="events">
      <div class="region-section__head">
        <span class="region-section__tick" aria-hidden="true"></span>
        <h2>Festivals &amp; events</h2>
      </div>
      {# Default subtitle; region-data.js swaps this text when the live fetch comes back
         quotaExceeded (KTO's daily call quota is gone) — events.js drops items entirely in that
         case (no top-picks-style fallback, see events.js header comment), so the subtitle itself
         carries the honest message instead of a card in the timeline below. Reset on every
         render so a stale message can't survive a state that later succeeds. #}
      <p class="region-section__sub" data-events-subtitle>Ongoing now, and what's coming up</p>
      {# Live per-request data (functions/api/region/[slug]/events.js), fetched and rendered by
         region-data.js. The <noscript> message is the real no-JS content; JS never lets a
         browser see it (region-data.js overwrites this container's innerHTML on load). #}
      <div class="event-timeline" data-region-events data-region-slug="{{ region.slug }}">
        <noscript>
          <p class="empty-state">Live festival &amp; event data needs JavaScript — <a href="https://english.visitkorea.or.kr/" target="_blank" rel="noopener">browse the Korea Tourism Organization's English site instead ↗</a></p>
        </noscript>
      </div>
      {# Hidden by region-data.js when the live fetch comes back quotaExceeded — attributing an
         empty result to KTO is only honest when KTO was actually reached (a real zero-events
         region, e.g. Jeju, still gets a real answer and keeps the credit). #}
      <p class="data-provenance" data-events-provenance>Source: © Korea Tourism Organization (한국관광공사).</p>
    </div>
  </div>
</div>

<section class="region-section region-section--attractions" id="places">
  <div class="region-section__head">
    <span class="region-section__tick" aria-hidden="true"></span>
    <h2>Places to visit</h2>
  </div>
  {# Default subtitle; region-data.js swaps this text when the live fetch comes back
     quotaExceeded (KTO's daily call quota is gone) and falls back to the top-picks list, so
     "today's top picks" doesn't quietly read as the full live set. Reset on every render so a
     stale "top picks" message can't survive a state that later succeeds. #}
  <p class="region-section__sub" data-attractions-subtitle>What to explore in the region</p>
  {# Filter row — visual + selection state only for now. "Area" reuses the same cityList the
     "Cities" section above already resolved per region, so it only ever offers
     the cities actually shown on this page, not every city.json record. "Elsewhere" covers
     attractions not tied to one of those cities. Real filtering of the list below is next-step
     data work, not wired here.
     Jeju-do drops the "Elsewhere" pill entirely: lDongRegnCd 50 has exactly two signgu codes in
     Korea's administrative structure (Jeju-si 110, Seogwipo-si 130 — see cities.json), both
     already covered by jeju-city/seogwipo above, so nothing can ever land there — live-confirmed
     empty on both Nature and Culture (notes/attraction-gallery-report.md §7). Every other region
     keeps the pill; this is a Jeju-specific structural fact, not a general assumption. #}
  <div class="attraction-filters" data-attraction-filters>
    <div class="attraction-filters__group" role="group" aria-label="Filter by area">
      <span class="attraction-filters__label">Area</span>
      <div class="attraction-filters__pills">
        <button type="button" class="filter-pill is-selected" aria-pressed="true" data-filter-group="area" data-filter-value="all">All</button>
        {% for city in cityList %}
        <button type="button" class="filter-pill" aria-pressed="false" data-filter-group="area" data-filter-value="{{ city.slug }}">{{ city.nameEn }}</button>
        {% endfor %}
        {% if region.slug != "jeju-do" %}
        <button type="button" class="filter-pill" aria-pressed="false" data-filter-group="area" data-filter-value="elsewhere">Elsewhere</button>
        {% endif %}
      </div>
    </div>
    <div class="attraction-filters__group" role="group" aria-label="Filter by place type">
      <span class="attraction-filters__label">Type</span>
      <div class="attraction-filters__pills">
        <button type="button" class="filter-pill is-selected" aria-pressed="true" data-filter-group="type" data-filter-value="all">All</button>
        <button type="button" class="filter-pill" aria-pressed="false" data-filter-group="type" data-filter-value="nature">Nature</button>
        <button type="button" class="filter-pill" aria-pressed="false" data-filter-group="type" data-filter-value="culture">Culture</button>
      </div>
    </div>
  </div>
  {# Same live-fetch pattern as the events timeline above. #}
  <ul class="attraction-list" data-region-attractions data-region-slug="{{ region.slug }}">
    <noscript>
      <li class="empty-state">Live attraction data needs JavaScript — <a href="https://english.visitkorea.or.kr/" target="_blank" rel="noopener">browse the Korea Tourism Organization's English site instead ↗</a></li>
    </noscript>
  </ul>
  <p class="data-provenance">Source: © Korea Tourism Organization (한국관광공사).</p>
</section>

{% if regionFood.length %}
<section class="region-section region-section--food" id="dishes">
  <div class="region-section__head">
    <span class="region-section__tick" aria-hidden="true"></span>
    <h2>Regional dishes</h2>
  </div>
  {% if region.slug == "jeju-do" %}
  <p class="region-section__sub">A few handpicked representative dishes</p>
  {% else %}
  <p class="region-section__sub">A few handpicked representative dishes, each associated with a city known for them</p>
  {% endif %}
  <ul class="dish-list">
    {% for dish in regionFood %}
    <li class="dish-card">
      <div class="dish-card__figure">
        {% if dish.photo %}
        <img class="dish-card__media" src="{{ dish.imagePath }}" alt="{{ dish.nameEn }}" loading="lazy" decoding="async">
        {% else %}
        <div class="media-placeholder dish-card__media" aria-hidden="true"></div>
        {% endif %}
        {% if dish.heat or dish.kind %}
        <div class="dish-card__plates">
          {% if dish.heat == "spicy" %}<span class="dish-plate dish-plate--spicy">spicy</span>{% endif %}
          {% if dish.kind == "spicy-ingredient" %}<span class="dish-plate dish-plate--spicy-ingredient">spicy ingredient</span>{% endif %}
          {% if dish.kind == "drink" %}<span class="dish-plate dish-plate--drink">drink</span>{% endif %}
          {% if dish.kind == "dessert" %}<span class="dish-plate dish-plate--dessert">dessert</span>{% endif %}
        </div>
        {% endif %}
        {% if dish.city %}<p class="dish-card__city">{{ dish.city }}</p>{% endif %}
      </div>
      <h3 class="dish-card__name">{{ dish.nameEn }} <span class="dish-card__ko">{{ dish.nameKo }}</span></h3>
      <p class="dish-card__note">{{ dish.caption }}</p>
      {% if dish.restaurantUrl %}
      <a class="dish-card__restaurant" href="{{ dish.restaurantUrl }}" target="_blank" rel="noopener">Where to eat it ↗</a>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% if (regionFood | dump).indexOf('"kind":"spicy-ingredient"') !== -1 %}
  <p class="dish-legend"><span class="dish-plate dish-plate--spicy-ingredient">spicy ingredient</span> can usually be left out or served separately.</p>
  {% endif %}
  {% if (regionFood | dump).indexOf('"photo"') !== -1 %}
  <p class="data-provenance">Source: © Korea Tourism Organization (한국관광공사).{% for dish in regionFood %}{% if dish.photo and dish.photo.src != "Korea Tourism Organization" %} {{ dish.nameEn }}: {{ dish.photo.author }}{% if dish.photo.license %} / <a href="{{ dish.photo.licenseUrl }}" target="_blank" rel="noopener">{{ dish.photo.license }} ↗</a>{% endif %}.{% endif %}{% endfor %}</p>
  {% endif %}
</section>
{% endif %}
</div>
