---
pagination:
  data: regions
  size: 1
  alias: region
permalink: "/regions/{{ region.slug }}/"
layout: layouts/page.njk
eleventyComputed:
  title: "{{ region.nameEn }}"
  description: "{{ region.shortIntro }}"
---
{% set cost = costOfLiving | findBySlug(region.slug) %}
{% set transportInfo = transport | findBySlug(region.slug) %}
{% set regionCities = cities | byRegion(region.slug) %}
{% set regionFood = food | byRegion(region.slug) %}
{% set heroPhotos = regionHeroPhotos[region.slug] or [] %}
{% set slideCount = heroPhotos.length %}
<div class="content-page">
<header class="region-header">
  <h1>{{ region.nameEn }} <span class="region-header__ko">{{ region.nameKo }}</span></h1>
  <ul class="region-header__tags">
    {% for tag in region.vibeTags %}
    <li>{{ tag }}</li>
    {% endfor %}
  </ul>
  <p class="region-header__intro">{{ region.longIntro }}</p>
</header>

{# Region cover photo gallery: heroPhotos (regionHeroPhotos.json) is the ordered list of
   finalized, credited, license-checked picks per slug. Nav/dots/autoplay (region-hero-gallery.js)
   are pure enhancement — the track is a plain CSS scroll-snap strip, swipeable with zero JS
   (same no-JS pattern as .attraction-list), so nothing here gates content behind JS. #}
<div class="region-hero{% if slideCount == 0 %} region-hero--placeholder{% endif %}"{% if slideCount > 0 %} data-region-hero-gallery{% endif %}>
  {% if slideCount > 0 %}
  <div class="region-hero-gallery__track">
    {% for filename in heroPhotos %}
    {% set credit = regionHeroCredits.photos[filename] %}
    <figure class="region-hero-gallery__slide">
      <img class="region-hero__img" src="/assets/img/hero/{{ filename }}" alt="{{ credit.titleEn }}" loading="{{ 'eager' if loop.first else 'lazy' }}">
      {% if credit.titleEn %}
      <figcaption class="region-hero__caption">
        <span class="region-hero__caption-en">{{ credit.titleEn }}{% if credit.cityEn %}, {{ credit.cityEn }}{% endif %}</span>
        {% if credit.titleKo %}
        <span class="region-hero__caption-ko">{{ credit.titleKo }}{% if credit.cityKo %}, {{ credit.cityKo }}{% endif %}</span>
        {% endif %}
      </figcaption>
      {% endif %}
    </figure>
    {% endfor %}
  </div>
  {% if slideCount > 1 %}
  <button class="region-hero-gallery__nav region-hero-gallery__nav--prev" type="button" aria-label="Previous photo">‹</button>
  <button class="region-hero-gallery__nav region-hero-gallery__nav--next" type="button" aria-label="Next photo">›</button>
  <div class="region-hero-gallery__dots"></div>
  {% endif %}
  <p class="region-hero__credit">Photo source: © Korea Tourism Organization (한국관광공사)</p>
  {% endif %}
</div>

{% set tabs = [
  { id: "overview", label: "Overview" },
  { id: "living-info", label: "Living Info" }
] %}
{% include "partials/tabs.njk" %}

<section id="overview" class="region-section">
  <h2>Overview</h2>
  <div class="region-overview-grid">
    <div class="region-overview-grid__cities">
      <h3>Where you'd live</h3>
      {% if regionCities.length %}
      <ul class="city-list">
        {% for city in regionCities %}
        <li class="city-list__item">
          <h4>{{ city.nameEn }} <span class="city-list__ko">{{ city.nameKo }}</span></h4>
          <p>{{ city.blurb }}</p>
          {% if city.isPopulationDeclineArea %}
          <p class="city-list__badge">Population-decline-designated area</p>
          {% endif %}
          {% if city.workationCenters.length %}
          <ul class="city-list__workation">
            {% for wc in city.workationCenters %}
            <li>{{ wc.name }}{% if wc.note %} <span class="note">({{ wc.note }})</span>{% endif %}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      {% set message = "No workation-centre cities currently listed for this region." %}
      {% include "partials/empty-state.njk" %}
      {% endif %}
    </div>
    <div class="region-overview-grid__events">
      <h3>Festivals &amp; events</h3>
      {# Phase 23: live per-request data (functions/api/region/[slug]/events.js), fetched and
         rendered by region-data.js — can't be a build-time shortcode any more. The <noscript>
         message is the real no-JS content; JS never lets a browser see it (region-data.js
         overwrites this container's innerHTML on load), so it's inert whenever JS runs. #}
      <div class="event-timeline" data-region-events data-region-slug="{{ region.slug }}">
        <noscript>
          <p class="empty-state">Live festival/event data needs JavaScript. <a href="https://english.visitkorea.or.kr/">Browse the Korea Tourism Organization's English site instead →</a></p>
        </noscript>
      </div>
      <p class="data-provenance">Source: © Korea Tourism Organization (한국관광공사).</p>
    </div>
  </div>

  <div class="region-block">
    <h3>Attractions</h3>
    {# Same live-fetch pattern as the events timeline above. #}
    <ul class="attraction-list" data-region-attractions data-region-slug="{{ region.slug }}">
      <noscript>
        <li class="empty-state">Live attraction data needs JavaScript. <a href="https://english.visitkorea.or.kr/">Browse the Korea Tourism Organization's English site instead →</a></li>
      </noscript>
    </ul>
    <p class="data-provenance">Source: © Korea Tourism Organization (한국관광공사).</p>
  </div>

  {% if regionFood.length %}
  <div class="region-block">
    <h3>Local food</h3>
    <ul class="dish-list">
      {% for dish in regionFood %}
      <li class="dish-card">
        <div class="media-placeholder dish-card__media" aria-hidden="true"></div>
        <h4>{{ dish.nameEn }} <span class="dish-card__ko">{{ dish.nameKo }}</span></h4>
        <p>{{ dish.caption }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>

<section id="living-info" class="region-section">
  <h2>Living Info</h2>

  {% if cost %}
  <div class="region-block">
    <h3>Cost of living <span class="mock-note">mock placeholder figures — not yet verified</span></h3>
    <dl class="cost-summary">
      <div><dt>Rent, 1BR city centre</dt><dd>₩{{ cost.rent1brCityCentre | krw }}/mo</dd></div>
      <div><dt>Monthly budget, single person</dt><dd>₩{{ cost.monthlyBudgetSingle | krw }}/mo</dd></div>
      <div><dt>Inexpensive meal</dt><dd>₩{{ cost.mealInexpensive | krw }}</dd></div>
      <div><dt>Transit pass</dt><dd>₩{{ cost.transitPass | krw }}/mo</dd></div>
      <div><dt>Utilities</dt><dd>₩{{ cost.utilities | krw }}/mo</dd></div>
    </dl>
  </div>
  {% endif %}

  {% if transportInfo %}
  <div class="region-block">
    <h3>Getting around</h3>
    <ul class="transport-summary__airports">
      {% for airport in transportInfo.airports %}
      <li>{{ airport.name }} ({{ airport.iata }}) — {{ airport.note }}</li>
      {% endfor %}
    </ul>
    <p>{{ transportInfo.railNote }}</p>
    <p>{{ transportInfo.intercityBusNote }}</p>
    <p>{{ transportInfo.localTransitNote }}</p>
    <p>
      {% if transportInfo.carRecommended %}A car is recommended for getting around comfortably.
      {% else %}A car isn't necessary — public transit covers most needs.{% endif %}
    </p>
  </div>
  {% endif %}
</section>
</div>
