# Copy to .env (gitignored) — read by `npm run pages:dev` and by scripts/*
# (`node --env-file=.env`).
# Production keys are set in the Cloudflare Pages dashboard, not in any file.
# KTO English Tourism Information OpenAPI service key (used server-side only, in functions/api/**).
KTO_API_KEY=
# Kakao REST API key (Kakao Local, study-café counts; used server-side only).
KAKAO_REST_API_KEY=
# Dev-only: serve repeat identical KTO calls from an in-memory cache. Never set in production.
# KTO_DEV_CACHE=1
